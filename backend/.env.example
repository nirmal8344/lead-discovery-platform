# ==============================================================================
# Lead Discovery Platform - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real credentials to version control.
# ==============================================================================

# ---------- Database ----------
DB_URL=jdbc:postgresql://localhost:5432/lead_discovery
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# ---------- Server ----------
PORT=8080

# ---------- Spring Profile ----------
# Set to "production" for Railway deployment, leave empty for local dev
SPRING_PROFILES_ACTIVE=

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- JWT Security ----------
# Generate a 256-bit secret key (min 32 bytes, hex-encoded)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
# Token expiration: 24 hours = 86400000 ms
JWT_EXPIRATION_MS=86400000

# ---------- Production Only (Railway) ----------
# Connection pool size (optional, defaults shown)
# DB_POOL_MAX=10
# DB_POOL_MIN=2


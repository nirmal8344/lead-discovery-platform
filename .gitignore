# ==============================================================================
# Lead Discovery Platform - Git Ignore Rules
# ==============================================================================

# Java / Maven Build Artifacts
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Node / Frontend Build Artifacts
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo

# Environment & Secrets (Never commit actual credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!**/.env.example

# IDE & Editor Files
.idea/
**/.idea/
.vscode/
**/.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.classpath
.project
.settings/

# Playwright & Browser Binaries
.playwright/
**/test-results/
playwright-report/
blob-report/

# Logs & Temporary Files
*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
scratch/
temp/
tmp/

# OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini